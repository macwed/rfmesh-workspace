# both3-poc config. Copy to `.env` (dev) and `.env.prod` (prod), both gitignored.
# Every value is read by the backend at startup (see backend/src/both3_poc/config.py)
# and/or interpolated by docker compose. No real secrets here — Cloudflare does TLS.

# Where "Send to troops" ships CoT. Bundled FTS = tcp://freetakserver:8087.
# On-site: repoint at a real ATAK/FTS, e.g. tcp://10.0.0.5:8087. No rebuild needed.
COT_ENDPOINT_URL=tcp://freetakserver:8087

# Marker UID prefix / <contact callsign> on emitted CoT.
COT_CALLSIGN=rfmesh

# UI staleness fade threshold, seconds (matches rfmesh-cot STALE_AFTER_S).
STALE_WINDOW_S=30

# Seed the map from docs/demo/artifacts/trench_demo_fixes.json at startup.
# dev: true   prod: false
SEED_DEMO=true

# Treat seeded (old-timestamp) data as fresh so the demo isn't all-grey.
# dev: true   prod: false
SEED_AS_FRESH=true

# FastAPI CORS allow-origin.  dev: *   prod: https://both3.huplo.cc
CORS_ALLOW_ORIGINS=*

# Line-of-bearing ray length drawn from each contributing node, metres.
LOB_LENGTH_M=6000

# FreeTAKServer image.
#
# DEFAULT (RECOMMENDED): the locally-built FreeTAKServer 1.9.9.6 image
# (deployment/fts199/). The dev compose overlay has a `build:` for this service,
# so `up --build` produces `fts199:local` automatically — no separate docker
# build step. 1.9.9.6 ingests + PERSISTS every hostile-emitter marker over plain
# TCP with no presence handshake (verified: distinct marker uids land in the FTS
# event DB, no IAM NoneType error).
FTS_IMAGE=fts199:local
#
# DO NOT USE for marker ingestion: the 2.x digitalpy `:latest` image. It accepts
# a marker over TCP (logs `client has connected`) but then DROPS it with
# `IAMUsersController ... a bytes-like object is required, not 'NoneType'`, and
# only ever persists the FIRST event — new/repeat markers never reach the DB.
# Kept here only as the documented broken baseline:
# FTS_IMAGE=ghcr.io/freetakteam/freetakserver:latest

# --- Host ports (avoid clashes; 8000 + 5678 are TAKEN by the `underline` project) ---
# Backend host port (container stays :8000). 8000 is taken -> use 8088.
BACKEND_HOST_PORT=8088
# FreeTAKServer-UI host port (container stays :5000). Use 5055 if 5000 is taken.
FTSUI_HOST_PORT=5055
# Optional Node-RED FreeTAKHub-WebMap host port for the UI's /webmap iframe.
# Not run by default (no upstream image); 8000 is taken so this defaults to 8001.
FTSMAP_HOST_PORT=8001
# What the browser uses to reach the webmap iframe (host the webmap is published on).
FTS_MAP_BROWSER_IP=localhost

# --- FreeTAKServer-UI login (see README "View what the troops see") ---
# Open http://localhost:${FTSUI_HOST_PORT} and log in with the default FTS
# SystemUser:  admin / password.  The UI forwards these to the FTS REST API.
# The UI->FTS API token below must match a SystemUser token in FTS; the default
# `admin` SystemUser token is the literal string "token", so "Bearer token" works.
# (Set in docker-compose.yml as FTS_API_KEY; override here if you rotate it.)
# FTS_API_KEY=Bearer token

# Dev-only: makes uvicorn --reload fire under Docker-Desktop/Windows bind mounts.
WATCHFILES_FORCE_POLLING=true
